    <string name="tour_hello_title">Welcome to Mheenotes 👋</string>
    <string name="tour_hello_body">A calm, fast notebook for your pen. Let's set a couple of things up. It takes less than a minute.</string>
    <string name="tour_theme_title">Pick your look</string>
    <string name="tour_theme_body">Light, dark, or follow your tablet. You can change it any time in Settings.</string>
    <string name="tour_write_title">Just start writing ✍️</string>
    <string name="tour_write_body">Your pen writes and your finger scrolls. Scribble over ink to erase it, and hold at the end of a stroke to snap it into a clean shape.</string>
    <string name="tour_pdf_title">Bring your PDFs 📄</string>
    <string name="tour_pdf_body">Tap New, then Import PDF, or share a PDF to Mheenotes from any app. Write right on the pages, search their text, and export it back.</string>
    <string name="tour_gesture_title">Handy gestures</string>
    <string name="tour_gesture_body">Tap with two fingers to undo and three to redo. Pinch to zoom, and use the lasso to move, recolor or capture anything.</string>
    <string name="tour_ready_title">You're all set 🎉</string>
    <string name="tour_ready_body">Create your first notebook, or start from a PDF. You can replay this tour from Settings.</string>
